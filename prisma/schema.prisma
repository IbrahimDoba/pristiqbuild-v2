// PristiqBuild data layer.
// Phase 2 scope: lead capture only. User/Note are here because the CRM in
// Phase 5 reads from them and adding the relations later would mean a
// second migration over live lead data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Every enquiry the site collects, whatever form it came from.
model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Who
  name    String
  email   String
  phone   String?
  company String?

  // What they want
  source      LeadSource
  projectType String?
  location    String?
  budgetBand  String?
  message     String?    @db.Text

  /// Form-specific extras: calculator inputs, UTM params, referrer, user agent.
  /// Keeps new forms from needing a migration.
  payload Json?

  // Pipeline. Unused until Phase 5, defaulted so Phase 2 does not care.
  stage        LeadStage @default(NEW)
  ownerId      String?
  owner        User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  notes        Note[]
  nextActionAt DateTime?

  // Delivery tracking, so a failed notification is visible rather than silent.
  notifiedAt DateTime?

  @@index([stage, createdAt])
  @@index([source, createdAt])
  @@index([email])
}

enum LeadSource {
  CONTACT_FORM
  QUOTE_FORM
  CALCULATOR
  NEWSLETTER
  WHATSAPP
}

enum LeadStage {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

/// Internal team member. Signs in to /admin.
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email String  @unique
  name  String?
  image String?
  role  UserRole @default(MANAGER)

  /// bcrypt. Null means the account cannot sign in yet, which is how an
  /// invited-but-not-activated user is represented.
  passwordHash String?

  /// Set on every successful sign-in, so a dormant account is visible.
  lastLoginAt DateTime?

  /// Lets an account be revoked without deleting it and orphaning its notes.
  isActive Boolean @default(true)

  leads    Lead[]
  notes    Note[]
  projects ProjectMember[]
  expenses Expense[]

  @@index([email])
}

/// Who someone is in the company. Capabilities are derived from this in
/// lib/admin/permissions.ts rather than stored per user, so there is one place
/// to read and change the rules.
enum UserRole {
  /// Full access, including the books and the team.
  CO_FOUNDER
  /// Same operational reach as a co-founder. Runs the business day to day.
  ADMIN
  /// Leads and delivery. Sees costs only for projects they are assigned to.
  MANAGER
  /// Blog and site content. Never sees leads or money.
  CONTENT_SPECIALIST
}

/// Follow-up log against a lead.
model Note {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body String @db.Text

  @@index([leadId, createdAt])
}

/// An internal job we are spending money on.
///
/// Deliberately unrelated to the five public project pages, which are
/// hardcoded marketing pages with bespoke layouts. Most internal work never
/// goes public, and finance should not depend on marketing copy.
model Project {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name     String
  client   String?
  location String?
  status   ProjectStatus @default(ACTIVE)

  startedAt DateTime?
  endedAt   DateTime?

  /// Total planned spend. Per-category planning lives in Budget.
  /// numeric(14,2) rather than a float: binary floating point cannot represent
  /// most decimal amounts exactly, and money must not drift.
  budget Decimal? @db.Decimal(14, 2)

  notes String? @db.Text

  members  ProjectMember[]
  expenses Expense[]
  budgets  Budget[]

  @@index([status, name])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

/// Which managers may see a project's costs. Co-founders and admins see every
/// project regardless and are not listed here.
model ProjectMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

/// Money that has actually gone out.
model Expense {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("NGN")

  category    ExpenseCategory
  vendor      String?
  description String          @db.Text

  /// When the money was spent, which is not when it was typed in.
  spentAt DateTime

  recordedById String?
  recordedBy   User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  receiptUrl String?

  /// How the record was created. Kept so an AI-assisted entry can be found and
  /// reviewed later if its parsing turns out to be wrong.
  entryMethod EntryMethod @default(MANUAL)
  /// The sentence the AI parsed, when it was one.
  sourceText String? @db.Text

  @@index([projectId, spentAt])
  @@index([category, spentAt])
  @@index([spentAt])
}

enum ExpenseCategory {
  MATERIALS
  LABOUR
  EQUIPMENT
  TRANSPORT
  PERMITS
  SUBCONTRACTOR
  PROFESSIONAL_FEES
  UTILITIES
  OTHER
}

enum EntryMethod {
  MANUAL
  AI_ASSISTED
}

/// Planned spend for one category on one project.
model Budget {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category ExpenseCategory
  amount   Decimal         @db.Decimal(14, 2)

  @@unique([projectId, category])
}
