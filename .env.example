# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------

# Database (required)
# Local dev:  postgresql://USER@localhost:5432/pristiqbuild_dev?schema=public
# Neon:       copy the pooled connection string from the Neon dashboard and
#             keep `?sslmode=require`.
DATABASE_URL="postgresql://user@localhost:5432/pristiqbuild_dev?schema=public"

# Lead notifications (required in production)
# Without RESEND_API_KEY the API logs the email to stdout instead of sending,
# so local development and CI need no credentials.
LEAD_NOTIFY_TO=info@pristiqbuild.com
LEAD_NOTIFY_FROM="PristiqBuild <leads@pristiqbuild.com>"
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Admin authentication (required)
# Generate with: openssl rand -base64 32
# Changing it signs everyone out.
AUTH_SECRET=

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.pristiqbuild.com
NEXT_PUBLIC_SITE_NAME=PristiqBuild

# Contact Information
NEXT_PUBLIC_COMPANY_EMAIL=info@pristiqbuild.com
NEXT_PUBLIC_COMPANY_PHONE=+2348130272706
NEXT_PUBLIC_CAREERS_EMAIL=careers@pristiqbuild.com

# Social Media
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61565826015488
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/pristiqbuild/
NEXT_PUBLIC_LINKEDIN_URL=https://ng.linkedin.com/company/pristiqbuild

# Google Analytics (Phase 1)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# Microsoft Clarity
# NEXT_PUBLIC_CLARITY_PROJECT_ID=your-project-id
